# Backend image build context = repo ROOT (it needs backend/ AND db/schema.sql for the
# bring-up job). Keep those; drop everything heavy, VCS, caches, tests, and ALL secrets.
.git
.github
frontend
archive
sample_data
deploy
*.md
PROJECT_*.md
README.md

# Python caches / virtualenvs / tool caches
**/__pycache__
**/*.pyc
**/*.pyo
backend/venv
backend/.venv
backend/.pytest_cache
backend/.ruff_cache
backend/.mypy_cache
backend/.next
backend/tests

# Secrets — never bake into an image
**/.env
**/.env.*
*.pem
*.key

**/.DS_Store
