# Copy to .env and fill in. Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT signing. RS256 (asymmetric): sign with the RSA private key, verify with the public
# key. Generate a keypair and append these lines with:
#   python generate_jwt_keys.py --env >> .env
# PEM newlines are escaped as \n in env and un-escaped by app/core/config.py.
# (Set JWT_ALGORITHM=HS256 to fall back to SECRET_KEY-based signing.)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_erp
POSTGRES_PORT=5432

# Non-owner role the app connects as to ENFORCE Postgres RLS (see enable_rls.py).
# Leave blank to connect as POSTGRES_USER (owner = RLS bypassed, manual filters only).
APP_DB_USER=
APP_DB_PASSWORD=

# Encrypts Aadhaar/APAAR/PEN at rest (Fernet). Blank = plaintext (dev). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Label shown in authenticator apps when enrolling 2FA (optional; has a default).
TOTP_ISSUER=Educore School ERP

BACKEND_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Third-party integrations (leave blank to run in mock/dev mode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Email (SMTP). Leave SMTP_HOST blank to log emails instead of sending (dev mock).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
