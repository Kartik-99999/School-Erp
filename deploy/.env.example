# =============================================================================
#  School ERP — Oracle Always Free deploy env. Copy to .env (gitignored) and fill in.
#  Generate the crypto material once (in backend/):
#    python generate_jwt_keys.py --env          # JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (\n-escaped)
#    python -c "from cryptography.fernet import Fernet; print('PII_ENCRYPTION_KEY='+Fernet.generate_key().decode())"
#    python -c "import secrets; print('SECRET_KEY='+secrets.token_urlsafe(48))"
#    python -c "import secrets; print('NEXTAUTH_SECRET='+secrets.token_urlsafe(48))"
#
#  NOTE: DB topology (POSTGRES_SERVER=pgbouncer, POSTGRES_PORT=6432, DB_PGBOUNCER=true,
#  DB_SSL_REQUIRE=false, REDIS_URL) is pinned in docker-compose.yml, not here.
# =============================================================================

# ---- Domain ----
BASE_DOMAIN=erpcore.tech
NEXT_PUBLIC_BASE_DOMAIN=erpcore.tech
NEXT_PUBLIC_API_URL=https://api.erpcore.tech/api/v1
ACME_EMAIL=admin@erpcore.tech

# ---- Caddy wildcard TLS (Cloudflare DNS-01). Token needs Zone:DNS:Edit on the zone. ----
CLOUDFLARE_API_TOKEN=

# ---- Postgres (owner; migrations + the server behind PgBouncer) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=school_erp

# ---- Non-owner app DB role (RLS-enforced; created by enable_rls.py during bring-up) ----
APP_DB_USER=educore_app
APP_DB_PASSWORD=

# ---- JWT (RS256) ----
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ---- Crypto / sessions ----
SECRET_KEY=
PII_ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ---- CORS (allow tenant subdomains of the base domain) ----
BACKEND_CORS_ORIGIN_REGEX=^https?://([a-z0-9-]+\.)*(erpcore\.tech)(:\d+)?$

# ---- Cloudinary (file storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMTP (email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---- Twilio (WhatsApp; per-school opt-in) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ---- Backups: nightly pg_dump -> Object Storage via rclone (see backup/pg_backup.sh) ----
# rclone remote:bucket (Oracle Object Storage S3-compat, or an AWS S3 remote).
BACKUP_RCLONE_REMOTE=oos:erp-backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE=
